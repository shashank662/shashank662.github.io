---
// The colour theme picker (spec §5). The button names the current choice; the menu, a native popover, lists Auto
// and the themes as radio buttons, each with a small page drawn in that theme's own colours (tokens.css applies a
// theme to any element with data-theme). The script keeps the ticks, the label and the page in step.
import { THEMES } from '../lib/theme';

const options = [{ id: 'auto', name: 'Auto' }, ...THEMES];
---
<button class="theme-btn" type="button" popovertarget="theme-menu" data-theme-button aria-label="Colour theme: Auto">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M8 1.5a6.5 6.5 0 1 0 0 13c1 0 1.5-.6 1.5-1.3 0-.9-.8-1.2-.8-2 0-.7.6-1.2 1.3-1.2h1.6c1.9 0 3.4-1.4 3.4-3.3C15 3.9 11.9 1.5 8 1.5z" stroke="currentColor" stroke-width="1.4" />
    <circle cx="4.6" cy="7.4" r="1" fill="currentColor" />
    <circle cx="6.8" cy="4.6" r="1" fill="currentColor" />
    <circle cx="10.2" cy="4.8" r="1" fill="currentColor" />
  </svg>
  <span data-theme-label>Auto</span>
</button>

<div class="menu" id="theme-menu" popover data-theme-menu role="dialog" aria-labelledby="theme-menu-title">
  <p class="title" id="theme-menu-title">Colour theme</p>
  <div class="grid" role="radiogroup" aria-label="Themes">
    {options.map((option) => (
      <button type="button" class="option" role="radio" aria-checked="false" tabindex="-1" data-choice={option.id}>
        <span class:list={['swatch', { auto: option.id === 'auto' }]} data-theme={option.id === 'auto' ? undefined : option.id} aria-hidden="true">
          {(option.id === 'auto' ? ['light', 'dark'] : [undefined]).map((half) => (
            <span class="page" data-theme={half}>
              <span class="side"><span /><span /><span /></span>
              <span class="main"><span class="bar" /><span class="block" /><span class="accent" /></span>
            </span>
          ))}
        </span>
        <span class="name">{option.name}</span>
        <svg class="tick" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <circle cx="9" cy="9" r="9" />
          <path d="M5 9.2l2.6 2.6L13 6.4" />
        </svg>
      </button>
    ))}
  </div>
</div>

<script>
  import '../scripts/theme-picker';
</script>

<style>
  .theme-btn {
    display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px 0 9px;
    border-radius: 999px; border: 1px solid var(--line); transition: border-color 0.25s;
  }
  .theme-btn:hover { border-color: var(--ink); }
  /* It needs JavaScript to do anything. */
  :global(html:not(.js)) .theme-btn { display: none; }

  .menu {
    /* Placed under the button by the script; these are its fallbacks. */
    position: fixed; inset: 72px var(--gutter) auto auto; margin: 0;
    width: min(460px, calc(100vw - 16px)); padding: 16px;
    border: 1px solid var(--line); border-radius: 14px; background: var(--bg); color: var(--ink);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.5);
  }
  .title { margin-bottom: 12px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); gap: 6px; }

  .option {
    position: relative; display: flex; flex-direction: column; align-items: stretch; gap: 6px; padding: 6px;
    border: 2px solid transparent; border-radius: 12px; font-size: 12.5px; text-align: center;
    transition: border-color 0.2s, color 0.2s;
  }
  .option:hover { border-color: var(--line); }
  .option[aria-checked='true'] { border-color: var(--accent); color: var(--accent); }
  .tick { position: absolute; top: -7px; right: -7px; display: none; }
  .tick circle { fill: var(--accent); }
  .tick path { fill: none; stroke: var(--on-accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .option[aria-checked='true'] .tick { display: block; }

  /* A small page in the theme's own colours: a side rail, a heading, a block of text and an accent button. */
  .swatch { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: 8px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
  .page { position: absolute; inset: 0; display: flex; background: var(--bg); }
  /* Auto: half light, half dark, split corner to corner. */
  .auto .page + .page { clip-path: polygon(100% 0, 100% 100%, 0 100%); }
  .side { display: flex; flex-direction: column; gap: 3px; width: 24%; padding: 6px 4px; background: var(--line2); }
  .side span { height: 3px; border-radius: 2px; background: var(--line); }
  .side span:first-child { background: var(--accent); }
  .main { display: flex; flex: 1; flex-direction: column; gap: 5px; padding: 6px 7px; }
  .bar { height: 4px; width: 60%; border-radius: 2px; background: var(--ink); opacity: 0.85; }
  .block { flex: 1; border-radius: 3px; background: var(--line2); }
  .accent { height: 3px; width: 44%; border-radius: 2px; background: var(--accent); }
</style>
