---
import SectionHead from './SectionHead.astro';
import WorkExhibit from '../work/WorkExhibit.astro';
import { getCases } from '../../data/work';
import { profile } from '../../data/profile';
import type { ExhibitKind } from '../../lib/exhibits';
const cases = await getCases();
const exhibits: Record<string, { kind: ExhibitKind; decision: number }> = {
  'auto-retry-framework': { kind: 'retry', decision: 2 },
  'rcs-billing-pipeline': { kind: 'billing', decision: 2 },
  'ai-code-reviewer': { kind: 'review', decision: 0 },
  'abandoned-cart-recovery': { kind: 'cart', decision: 0 },
};
const { brief } = profile.work;
---
<section class="section wrap" id="work">
  <SectionHead n="01" label="Selected work · Engati" meta="5 systems · 4 case studies" />
  <div class="intro"><h2 class="h2">Selected work</h2><p>Open the case study for the evidence.<br/>Try the artifact for the idea.</p></div>
  <p id="stack" class="skill-note mono">Skills in practice · technologies attached to the work below</p>
  <div class="exhibits">{cases.map(({ id, data }) => <WorkExhibit kind={exhibits[id].kind} title={data.title} href={`/work/${id}`} metric={data.row.metric} metricCaption={data.row.metricCaption} description={data.meta.find(m => m.label === 'Role')?.value + '. ' + data.row.description + '.'} stack={data.row.stack} decision={id === 'rcs-billing-pipeline' && data.tradeoff ? { title: data.tradeoff.title, body: `${data.steps.at(-1)} ${data.tradeoff.body}` } : data.decisions[exhibits[id].decision]} />)}</div>
  <details class="sandbox"><summary><span>{brief.title}</span><span>{brief.metric} · {brief.metricCaption}</span></summary><p>{brief.more}</p></details>
</section>
<script>import '../../scripts/exhibits';</script>
<style>
  .intro { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .intro p { font-size: 15px; line-height: 1.5; color: var(--muted); }
  .skill-note { margin: 28px 0 16px; font-size: 11px; color: var(--muted); scroll-margin-top: 100px; }
  .exhibits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .sandbox { border-block: 1px solid var(--line); margin-top: 28px; }
  summary { cursor: pointer; padding: 20px 0; min-height: 44px; }
  summary span:first-child { font-weight: 600; margin-right: 20px; }
  summary span:last-child { font-size: 14px; color: var(--muted); }
  .sandbox p { max-width: 850px; font-size: 15px; line-height: 1.6; padding-bottom: 22px; }
  @media (max-width: 760px) { .exhibits { grid-template-columns: 1fr; } .intro { display: block; } .intro p { margin-top: 16px; } }
</style>
