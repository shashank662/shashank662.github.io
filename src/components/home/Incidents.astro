---
import SectionHead from './SectionHead.astro';
import { profile } from '../../data/profile';
import { emphasize } from '../../lib/text';

const { incidents } = profile;
---
<section class="section wrap" id="incidents">
  <SectionHead n="04" label="Incidents" meta={`${incidents.items.length} resolved · 0 open`} />
  <h2 class="h2" set:html={emphasize(incidents.title)} />
  <p class="sub">{incidents.sub}</p>
  <div class="grid">
    {incidents.items.map((inc) => (
      <article class="inc" data-in-view>
        <p class="top mono"><span>{inc.id} · {inc.context}</span><span class="ok">● resolved</span></p>
        <h3 class="display">{inc.title}</h3>
        <dl>
          <dt class="mono">Impact</dt><dd>{inc.impact}</dd>
          <dt class="mono">Cause</dt><dd>{inc.cause}</dd>
          <dt class="mono">Fix</dt><dd>{inc.fix}</dd>
        </dl>
        <div class="res">
          <p class="delta display">{inc.delta}<small class="mono">{inc.deltaLabel}</small></p>
          <div class="bars mono" aria-hidden="true">
            <div class="bar-row"><span>before</span><span class="bar"><i style={`--w:${inc.before.width}`}></i></span><span>{inc.before.label}</span></div>
            <div class="bar-row"><span>after</span><span class="bar after"><i style={`--w:${inc.after.width}`}></i></span><span>{inc.after.label}</span></div>
          </div>
          <p class="visually-hidden">Before: {inc.before.label}. After: {inc.after.label}.</p>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import '../../scripts/in-view';
</script>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: 44px; border-top: 1.5px solid var(--ink); }
  .inc { padding: 28px 30px 32px 0; border-bottom: 1px solid var(--line); }
  .inc + .inc { padding-left: 30px; padding-right: 0; border-left: 1px solid var(--line); }
  .top { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--muted); }
  .ok { color: var(--ok); }
  h3 { font-size: clamp(26px, 2.8vw, 40px); line-height: 1.02; margin: 16px 0 20px; }
  dl { display: grid; grid-template-columns: 78px 1fr; gap: 9px 16px; font-size: 15px; line-height: 1.5; }
  dt { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; padding-top: 4px; }
  .res { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-top: 26px; }
  .delta { font-size: clamp(44px, 5.4vw, 80px); line-height: 0.9; color: var(--accent); }
  .delta small { display: block; margin-top: 8px; font-size: 11px; letter-spacing: 0.02em; color: var(--muted); text-transform: none; }
  .bars { flex: 1; max-width: 260px; font-size: 11px; color: var(--muted); }
  .bar-row { display: grid; grid-template-columns: 48px 1fr 56px; gap: 10px; align-items: center; margin-top: 8px; }
  .bar-row span:last-child { text-align: right; color: var(--ink); }
  .bar { position: relative; display: block; height: 10px; background: var(--line2); }
  .bar i {
    position: absolute; top: 0; bottom: 0; left: 0; width: calc(var(--w) * 100%);
    background: var(--ink); transform-origin: left; transition: transform 1.3s var(--ease-out) 0.2s;
  }
  .bar.after i { background: var(--accent); transition-delay: 0.55s; }
  :global(.js) .inc .bar i { transform: scaleX(0); }
  :global(.js) .inc:global(.in) .bar i { transform: scaleX(1); }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .inc, .inc + .inc { padding-left: 0; padding-right: 0; border-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar i { transition: none; }
  }
</style>
