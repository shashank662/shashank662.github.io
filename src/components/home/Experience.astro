---
import SectionHead from './SectionHead.astro';
import { profile, type CareerProject, type CareerSpan } from '../../data/profile';
import { formatDuration, formatRange, monthsBetween, toAttr } from '../../lib/dates';
const dated = profile.career.spans.filter((s): s is CareerSpan => !s.within);
const projects = profile.career.spans.filter((s): s is CareerProject => Boolean(s.within));
---
<section class="section wrap" id="exp">
  <div id="about"><SectionHead n="02" label="Career" /><h2 class="h2">From foundations<br/>to production.</h2></div>
  <ol class="roles">
    {dated.map((span, i) => <li class="role">
      <div class="when"><span class="milestone mono">0{i + 1}</span><h3>{span.name}</h3><p class="mono">{formatRange(span.start, span.end)} · <span data-duration data-start={toAttr(span.start)} data-end={span.end ? toAttr(span.end) : ''}>{formatDuration(monthsBetween(span.start, span.end))}</span></p></div>
      <div class="what">
        <p class="detail">{span.id === 'internship' ? 'Production release: a full-stack cart recovery flow.' : span.line}</p>
        <ul class="projects">{projects.filter(p => p.within === span.id).map(p => <li><a href={p.href}><span aria-hidden="true">↗</span>{p.name}</a></li>)}</ul>
        {span.id !== 'education' && <details><summary>Ownership{span.awards ? ' & recognition' : ''}</summary><p>{span.detail}</p>{span.awards?.map(award => <p class="award">✺ {award}</p>)}</details>}
      </div>
    </li>)}
  </ol>
</section>
<script>import '../../scripts/durations';</script>
<style>
  #about { scroll-margin-top: 100px; }
  .roles { margin-top: 40px; border-top: 1px solid var(--ink); }
  .role { display: grid; grid-template-columns: 1fr 1.4fr; gap: 30px; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .when { padding-left: 45px; position: relative; }
  .milestone { position: absolute; left: 0; top: 2px; color: var(--accent); font-size: 12px; }
  h3 { font-size: 23px; line-height: 1.2; font-weight: 600; }
  .when p { font-size: 12px; color: var(--muted); margin-top: 10px; }
  .detail { font-size: 16px; line-height: 1.5; }
  .projects { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .projects a { display: flex; align-items: center; min-height: 44px; gap: 9px; padding: 8px 12px; border: 1px solid var(--line); font-size: 13px; border-radius: 4px; }
  .projects a:hover { border-color: var(--accent); }
  .projects span { color: var(--accent); }
  summary { min-height: 44px; padding: 13px 0; cursor: pointer; font-size: 13px; }
  details p { font-size: 14px; line-height: 1.6; color: var(--ink-2); }
  .award { margin-top: 8px; }
  @media (max-width: 760px) { .role { grid-template-columns: 1fr; gap: 18px; } .what { padding-left: 45px; } }
</style>
