---
import Status from '../Status.astro';

interface Props {
  n: string;
  label: string;
  meta?: string;
  /** Shows the live status pill on the right instead of a meta line. */
  status?: boolean;
}

const { n, label, meta, status = false } = Astro.props;
---
<div class="sec-head">
  <p class="label">({n}) {label}</p>
  {meta && <p class="label mono meta">{meta}</p>}
  {status && <p class="label mono meta"><Status /></p>}
</div>

<style>
  /* On a narrow screen the meta drops to its own line instead of both halves wrapping mid-phrase. */
  .sec-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px;
    padding-bottom: 14px; border-bottom: 1.5px solid var(--ink);
  }
  .meta { letter-spacing: 0.01em; text-transform: none; }
</style>
