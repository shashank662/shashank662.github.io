---
// The home page's landing screen: "SHR" opens out of a blue line on a dark screen, then the view dives through the S
// into the page (spec §5). It shows only while html.landing is set, which the inline script in index.astro does
// before first paint on a first visit; without JavaScript, or with reduced motion, there is nothing to see.
import { BAND } from '../../lib/landing';
import { SHR_GLYPHS } from '../../lib/shr-glyphs';

const { letters } = SHR_GLYPHS;
/** Each letter at its place in the word, opening through its own band. */
const uses = letters.map((letter, i) => ({ href: `#landing-${letter.char}`, x: letter.x, 'clip-path': `url(#landing-band-${i})` }));
---
<svg class="landing" data-landing aria-hidden="true" focusable="false">
  <defs>
    {/* Outlines in font units, y up; the script scales and flips them into place. */}
    {letters.map((letter) => <path id={`landing-${letter.char}`} d={letter.d} vector-effect="non-scaling-stroke" />)}
    {letters.map((_, i) => (
      <clipPath id={`landing-band-${i}`} clipPathUnits="userSpaceOnUse">
        <rect data-band x="-100000" y={BAND.middle} width="200000" height="0" />
      </clipPath>
    ))}
    {/* The letters cut holes in the dark screen, so the page is there, inside the S, all along. */}
    <mask id="landing-holes" maskUnits="userSpaceOnUse" x="-100000" y="-100000" width="200000" height="200000">
      <rect x="-100000" y="-100000" width="200000" height="200000" fill="#fff" />
      <g data-holes fill="#000">{uses.map((use) => <use {...use} />)}</g>
    </mask>
  </defs>
  <rect class="screen" data-screen width="100%" height="100%" mask="url(#landing-holes)" />
  <g class="fill" data-fill>{uses.map((use) => <use {...use} />)}</g>
  <g class="echo" data-echo>{uses.map((use) => <use {...use} />)}</g>
  <rect class="line" data-line x="0" y="0" width="0" height="1.5" />
</svg>

<script>
  import '../../scripts/landing';
</script>

<style>
  /* A dark screen with light letters in every theme: each theme sets its own (tokens.css). */
  .landing {
    --dark: var(--intro-dark);
    --light: var(--intro-light);
    --blue: var(--intro-line);
    display: none;
  }
  /* Above the header and the chat button, below the paper grain and the cursor. */
  :global(html.landing) .landing {
    display: block; position: fixed; inset: 0; z-index: 85; width: 100%; height: 100%;
  }
  .screen { fill: var(--dark); }
  /* When the letters empty in the dive, their thin light outline stays, so the S still shows over a dark page. */
  .fill { fill: var(--light); stroke: var(--light); stroke-width: 1.5px; }
  .echo { fill: none; stroke: var(--blue); stroke-width: 1.4px; }
  .line { fill: var(--blue); }

  /* The page stays at the top while the screen is up. The reserved gutter keeps it from shifting when the scrollbar returns. */
  :global(html.landing) { overflow: hidden; overscroll-behavior: none; scrollbar-gutter: stable; }
  /* Behind the screen the page waits, see-through, for its fonts, so no text reflows once it shows: a reflow counts as
     layout shift even under the screen. See-through rather than hidden, so screen readers still read the page. The
     cursor stays, since it stands in for the pointer. */
  :global(html.landing:not(.landing-fonts) body > :not(main, .cursor)),
  :global(html.landing:not(.landing-fonts) main > :not([data-landing])) { opacity: 0; }
</style>
