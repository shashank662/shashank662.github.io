---
import { profile } from '../../data/profile';
import { formatDuration, monthsBetween, toAttr } from '../../lib/dates';
import { accentWords } from '../../lib/text';

const words = accentWords(profile.about.paragraph);
---
<section class="about wrap" id="about">
  <div>
    <h2 class="label">(01) About</h2>
    <dl class="facts mono">
      {profile.about.facts.map((fact) => (
        <Fragment>
          {fact.key && <dt>{fact.key}</dt>}
          <dd class:list={[{ ok: fact.tone === 'ok', more: !fact.key }]}>
            {fact.value}
            {fact.span && (
              <Fragment>
                {' '}<span class="nowrap">(<span
                  data-duration
                  data-start={toAttr(fact.span.start)}
                  data-end={fact.span.end ? toAttr(fact.span.end) : ''}
                >{formatDuration(monthsBetween(fact.span.start, fact.span.end))}</span>)</span>
              </Fragment>
            )}
          </dd>
        </Fragment>
      ))}
    </dl>
  </div>
  <p class="big" data-word-reveal>
    {words.map((w, i) => (
      <Fragment><span class:list={['w', { hl: w.accent }]}>{w.word}</span>{i < words.length - 1 ? ' ' : ''}</Fragment>
    ))}
  </p>
</section>

<script>
  import '../../scripts/durations';
  import '../../scripts/word-reveal';
</script>

<style>
  .about { display: grid; grid-template-columns: 1fr 3fr; gap: 4vw; padding-top: 12vw; padding-bottom: 8vw; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 7px 16px; margin-top: 26px; font-size: 12.5px; }
  dt { color: var(--muted); }
  .ok { color: var(--ok); }
  /* A second description of the term above: stays in the value column. */
  .more { grid-column: 2; }
  .nowrap { white-space: nowrap; }
  .big { font-size: clamp(28px, 3.6vw, 58px); line-height: 1.14; letter-spacing: -0.025em; font-weight: 500; }
  .w { transition: opacity 0.25s; }
  :global(.js) .w { opacity: 0.14; }
  .hl { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--accent); }

  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .w { opacity: 1; }
  }
</style>
