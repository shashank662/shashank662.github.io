---
import Status from './Status.astro';
import ThemePicker from './ThemePicker.astro';
import { profile } from '../data/profile';
---
<header class="hd" data-header>
  <a class="who" href="/"><b>{profile.name}</b><span>{profile.role}</span></a>
  <div class="mid"><Status /></div>
  <nav aria-label="Main">
    <a class="u link" href="/#work">Work</a>
    <a class="u link" href="/#play">Playground</a>
    <a class="u link" href="/#contact">Contact</a>
    {/* Text on wider screens; on a phone, where the header is tight, just the icon (the text stays for screen readers). */}
    <a class="u ext" href={profile.links.resume} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M4 1.75h6.5L14 5.25v11H4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M10.25 1.75v3.75H14M6.5 9h5M6.5 12h5" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <span>Résumé</span>
    </a>
    <a class="u ext" href={profile.links.linkedin} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <rect x="1" y="1" width="16" height="16" rx="3" fill="currentColor" />
        <path d="M4.6 7.2h2v6.2h-2zM5.6 4.2a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3zM8.1 7.2h1.9v.9c.3-.55 1-1.05 2.05-1.05 2 0 2.35 1.3 2.35 3v3.35h-2v-3c0-.7 0-1.6-1-1.6s-1.3.75-1.3 1.55v3.05h-2z" fill="var(--bg)" />
      </svg>
      <span>LinkedIn</span>
    </a>
    <a class="pill summary" href="/summary">60-sec view</a>
    <ThemePicker />
    {/* On a phone the links above fold into one menu (once JavaScript runs; without it they stay as they are). */}
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu" data-menu-button>
      <span class="bars" aria-hidden="true"><i></i><i></i></span>Menu
    </button>
  </nav>
  <div class="drawer" id="site-menu" data-menu hidden>
    <ul class="sections">
      <li><a href="/#work">Work</a></li>
      <li><a href="/#about">Career</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ul>
    <ul class="more">
      <li><a href="/summary">60-sec view</a></li>
      <li><a href={profile.links.resume} target="_blank" rel="noopener">Résumé <span aria-hidden="true">↗</span></a></li>
      <li><a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>
    </ul>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .hd {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding: 18px var(--gutter); font-size: 13px;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, padding 0.3s;
  }
  .hd:global(.scrolled) {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
    padding-top: 12px; padding-bottom: 12px;
  }
  .who b { font-weight: 600; }
  .who span { color: var(--muted); margin-left: 8px; }
  .mid { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
  nav { justify-self: end; display: flex; align-items: center; gap: 20px; }

  @media (max-width: 1000px) {
    .hd { grid-template-columns: 1fr auto; }
    .mid { display: none; }
  }
  .ext { display: flex; align-items: center; }
  .ext svg { display: none; }
  /* The 60-second view is an outline, not a filled accent button, so it doesn't outrank View work in the hero. */
  .summary { border-color: var(--line); }
  .summary:hover { border-color: var(--accent); color: var(--accent); }
  .menu-btn, .drawer { display: none; }

  @media (max-width: 760px) {
    .link, .who span { display: none; }
    nav { gap: 12px; }
    .ext { justify-content: center; width: 34px; height: 34px; }
    .ext svg { display: block; }
    .ext span {
      position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }

    /* With JavaScript, the phone header is the name, the theme and one Menu button. */
    :global(.js) .ext, :global(.js) .summary { display: none; }
    :global(.js) .menu-btn {
      display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px;
      border: 1px solid var(--line); border-radius: 999px; font-size: 13px; font-weight: 600;
    }
    .bars { display: grid; gap: 4px; width: 14px; }
    .bars i { display: block; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease-out); }
    .menu-btn[aria-expanded='true'] .bars i:first-child { transform: translateY(2.75px) rotate(45deg); }
    .menu-btn[aria-expanded='true'] .bars i:last-child { transform: translateY(-2.75px) rotate(-45deg); }

    :global(.js) .drawer:not([hidden]) {
      display: block; position: absolute; top: calc(100% + 6px); left: var(--gutter); right: var(--gutter);
      padding: 8px 20px 14px; border: 1px solid var(--line); border-radius: 16px;
      background: var(--bg); box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.45);
    }
    .drawer a { display: flex; align-items: center; min-height: 48px; }
    .sections a { font-family: var(--font-display); font-size: 28px; font-weight: 600; letter-spacing: -0.02em; }
    .sections li + li { border-top: 1px solid var(--line); }
    .more { display: flex; flex-wrap: wrap; gap: 0 22px; margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); }
    .more a { font-size: 15px; font-weight: 500; color: var(--ink-2); }
  }
</style>
