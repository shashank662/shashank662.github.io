---
import Status from './Status.astro';
import ThemePicker from './ThemePicker.astro';
import { profile } from '../data/profile';
---
<header class="hd" data-header>
  <a class="who" href="/"><b>{profile.name}</b><span>{profile.role}</span></a>
  <div class="mid"><Status /><span aria-hidden="true">·</span><span class="mono clock" data-clock>--:--:-- IST</span></div>
  <nav aria-label="Main">
    <a class="u link" href="/#work">Work</a>
    <a class="u link" href="/#play">Playground</a>
    <a class="u link" href="/#contact">Contact</a>
    {/* Text on wider screens; on a phone, where the header is tight, just the icon (the text stays for screen readers). */}
    <a class="u ext" href={profile.links.resume} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M4 1.75h6.5L14 5.25v11H4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M10.25 1.75v3.75H14M6.5 9h5M6.5 12h5" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <span>Résumé</span>
    </a>
    <a class="u ext" href={profile.links.linkedin} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <rect x="1" y="1" width="16" height="16" rx="3" fill="currentColor" />
        <path d="M4.6 7.2h2v6.2h-2zM5.6 4.2a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3zM8.1 7.2h1.9v.9c.3-.55 1-1.05 2.05-1.05 2 0 2.35 1.3 2.35 3v3.35h-2v-3c0-.7 0-1.6-1-1.6s-1.3.75-1.3 1.55v3.05h-2z" fill="var(--bg)" />
      </svg>
      <span>LinkedIn</span>
    </a>
    <a class="pill accent" href="/summary">60-sec view</a>
    <ThemePicker />
  </nav>
</header>

<style>
  .hd {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding: 18px var(--gutter); font-size: 13px;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, padding 0.3s;
  }
  .hd:global(.scrolled) {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
    padding-top: 12px; padding-bottom: 12px;
  }
  .who b { font-weight: 600; }
  .who span { color: var(--muted); margin-left: 8px; }
  .mid { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
  .clock { font-variant-numeric: tabular-nums; }
  nav { justify-self: end; display: flex; align-items: center; gap: 20px; }

  @media (max-width: 1000px) {
    .hd { grid-template-columns: 1fr auto; }
    .mid { display: none; }
  }
  .ext { display: flex; align-items: center; }
  .ext svg { display: none; }

  @media (max-width: 760px) {
    .link, .who span { display: none; }
    nav { gap: 12px; }
    .ext { justify-content: center; width: 34px; height: 34px; }
    .ext svg { display: block; }
    .ext span {
      position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }
  }
</style>
