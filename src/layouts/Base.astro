---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Ask from '../components/Ask.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  /** The page's 1200 × 630 preview image, from src/pages/og. */
  ogImage?: string;
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, ogImage = '/og/home.png', noindex = false } = Astro.props;
// Pages are built as single files, so they see their own path with ".html"; the public address has none.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site);
// Who the site is about, for search engines (spec §12).
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: profile.company },
  address: { '@type': 'PostalAddress', addressLocality: profile.location, addressCountry: 'IN' },
  url: Astro.site,
  sameAs: [profile.links.linkedin, profile.links.github],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
    {/* Preload what the first screen of most pages uses: the display face and the light and regular text weights. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload={[{ weight: 300 }, { weight: 400 }]} />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-strip" />
    <script is:inline>
      // Same rule as resolveTheme() in src/lib/theme.ts. Runs before first paint so the page never flashes.
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        // Content that animates in is only hidden when this class is present, so it always shows without JavaScript.
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" data-progress aria-hidden="true"></div>
    <div class="cursor" data-cursor-dot aria-hidden="true"></div>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <Ask />
    <script>
      import '../scripts/chrome';
      import '../scripts/cursor';
      import '../scripts/theme-toggle';
    </script>
  </body>
</html>
