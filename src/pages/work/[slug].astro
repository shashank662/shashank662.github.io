---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/work/Diagram.astro';
import { caseNumber, getCases, type Case } from '../../data/work';
import { diagrams } from '../../diagrams';
import { profile } from '../../data/profile';
import { emphasize, plainText } from '../../lib/text';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length], total: cases.length },
  }));
}

interface Props {
  entry: Case;
  next: Case;
  total: number;
}

const { entry, next, total } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const spec = diagrams[data.diagram];
// Every numbered dot in the diagram needs its numbered step underneath.
if (spec.steps.length !== data.steps.length) {
  throw new Error(`${entry.id}: the diagram has ${spec.steps.length} numbered dots but the page lists ${data.steps.length} steps`);
}
---
<Base title={`${data.title} · ${profile.name}`} description={plainText(data.lede)} ogImage={`/og/${entry.id}.png`}>
  <article class="case">
    <div class="top wrap">
      <a class="back mono" href="/#work">← Back to work</a>
      <span class="label mono">Case study {caseNumber(data.order)} / {caseNumber(total)}</span>
    </div>

    <header class="head wrap">
      <p class="label">{data.kicker}</p>
      <h1 class="title display" style={`view-transition-name: work-${entry.id}; view-transition-class: work-title`}>{data.title}</h1>
      <p class="lede" set:html={emphasize(data.lede)} />
      <dl class="meta mono">
        {data.meta.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd class:list={[{ ok: item.tone === 'ok' }]}>{item.tone === 'ok' ? `● ${item.value}` : item.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="stats wrap">
      {data.stats.map((stat) => (
        <div><b class="display">{stat.value}</b><span>{stat.caption}</span></div>
      ))}
    </div>

    <section class="sec wrap">
      <h2 class="label">(01) The problem</h2>
      <div class="prose"><Content /></div>
    </section>

    <section class="sec wrap">
      <h2 class="label">(02) How it works</h2>
      <div>
        <Diagram id={data.diagram} spec={spec} />
        <ol class="steps">{data.steps.map((step) => <li><span>{step}</span></li>)}</ol>
      </div>
    </section>

    <section class="sec wrap">
      <h2 class="label">(03) Key decisions</h2>
      <div class="decisions">
        {data.decisions.map((decision) => (
          <div><h3 class="display">{decision.title}</h3><p>{decision.body}</p></div>
        ))}
      </div>
    </section>

    <section class="sec wrap">
      <h2 class="label">(04) Results</h2>
      <div>
        <ul class="results">{data.results.map((result) => <li><span set:html={emphasize(result)} /></li>)}</ul>
        {data.quote && <blockquote class="quote">{data.quote}</blockquote>}
        {data.cta && <a class="cta mono" href={data.cta.href}>{data.cta.label} →</a>}
      </div>
    </section>

    <a class="next wrap" href={`/work/${next.id}`}>
      <span class="label">Next case study</span>
      <span class="display">{next.data.title} →</span>
    </a>
  </article>
</Base>

<style>
  .case { padding-top: 84px; }
  .top {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-top: 16px; padding-bottom: 16px; border-bottom: 1.5px solid var(--ink);
  }
  .back { font-size: 13px; transition: color 0.25s; }
  .back:hover { color: var(--accent); }

  .head { padding-top: 6vw; padding-bottom: 4vw; }
  .title { margin-top: 18px; font-size: clamp(56px, 11vw, 190px); line-height: 0.86; }
  .lede { max-width: 980px; margin-top: 26px; font-family: var(--font-serif); font-size: clamp(24px, 3vw, 44px); line-height: 1.12; }
  .lede :global(em) { color: var(--accent); }
  .meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 44px; border-top: 1px solid var(--line); }
  .meta div { padding: 14px 16px 0 0; }
  .meta dt { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .meta dd { margin-top: 6px; font-size: 13px; line-height: 1.5; }
  .meta .ok { color: var(--ok); }

  .stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink);
  }
  /* Position selectors only: Astro's scope attributes would make an adjacency rule like `div + div`
     outrank the phone layout below. */
  .stats div { padding: 26px 18px 24px; border-right: 1px solid var(--line); }
  .stats div:first-child { padding-left: 0; }
  .stats div:last-child { border-right: 0; }
  .stats b { display: block; font-size: clamp(28px, 3.6vw, 60px); line-height: 1; white-space: nowrap; color: var(--accent); }
  .stats span { display: block; margin-top: 10px; font-size: 13px; line-height: 1.45; color: var(--muted); }

  /* minmax(0, …) lets a column be narrower than its content, so the diagram scrolls inside its own box
     instead of widening the page. */
  .sec { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 4vw; padding-top: 6vw; }
  .prose :global(p) { max-width: 760px; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.6; }
  .prose :global(p + p) { margin-top: 1em; }
  .prose :global(strong), .results :global(strong) { font-weight: 600; }

  .steps { counter-reset: step; display: grid; gap: 12px; max-width: 780px; }
  .steps li { display: grid; grid-template-columns: 34px 1fr; font-size: 16.5px; line-height: 1.55; }
  .steps li::before {
    counter-increment: step; content: counter(step);
    display: grid; place-items: center; width: 24px; height: 24px; margin-top: 1px; border-radius: 50%;
    background: var(--accent); color: var(--on-accent); font: 600 12px var(--font-sans);
  }

  .decisions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .decisions div { padding: 20px 22px 22px 0; border-right: 1px solid var(--line); }
  .decisions div + div { padding-left: 22px; }
  .decisions div:last-child { border-right: 0; }
  .decisions h3 { font-size: 24px; line-height: 1.05; }
  .decisions p { margin-top: 10px; font-size: 15px; line-height: 1.6; color: var(--muted); }

  .results { display: grid; gap: 14px; }
  .results li { display: grid; grid-template-columns: 28px 1fr; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.5; }
  .results li::before { content: '→'; color: var(--accent); }
  .quote {
    max-width: 820px; margin-top: 36px; padding-left: 22px; border-left: 3px solid var(--accent);
    font-family: var(--font-serif); font-style: italic; font-size: clamp(24px, 2.6vw, 38px); line-height: 1.2;
  }
  .cta {
    display: inline-block; margin-top: 28px; padding-bottom: 3px; border-bottom: 1px solid currentColor;
    font-size: 13px; transition: color 0.25s;
  }
  .cta:hover { color: var(--accent); }

  .next { display: block; margin-top: 8vw; padding-top: 3vw; padding-bottom: 4vw; border-top: 1.5px solid var(--ink); }
  .next .display { display: block; margin-top: 14px; font-size: clamp(44px, 8vw, 130px); line-height: 0.9; transition: color 0.3s; }
  .next:hover .display { color: var(--accent); }

  @media (max-width: 860px) {
    .meta, .stats { grid-template-columns: 1fr 1fr; }
    .stats div:nth-child(odd) { padding-left: 0; }
    .stats div:nth-child(even) { border-right: 0; }
    .stats div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .sec { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .decisions { grid-template-columns: 1fr; }
    .decisions div, .decisions div + div { padding-left: 0; border-right: 0; border-bottom: 1px solid var(--line); }
  }
</style>
