---
import Base from '../layouts/Base.astro';
import Landing from '../components/home/Landing.astro';
import Hero from '../components/home/Hero.astro';
import Strips from '../components/home/Strips.astro';
import About from '../components/home/About.astro';
import Experience from '../components/home/Experience.astro';
import Work from '../components/home/Work.astro';
import Incidents from '../components/home/Incidents.astro';
import Playground from '../components/home/Playground.astro';
import Contact from '../components/home/Contact.astro';
import { profile } from '../data/profile';
---
<Base title={`${profile.name} · ${profile.role}`} description={profile.metaDescription} ogImage="/og/home.png">
  <script is:inline slot="head">
    // Same rule as shouldPlayLanding() in src/lib/landing.ts, with the same key. It runs before first paint,
    // so a first visit never glimpses the page before the landing screen covers it.
    (() => {
      let seen = true;
      try {
        seen = sessionStorage.getItem('landing') !== null;
        sessionStorage.setItem('landing', '1');
      } catch {}
      let fromSite = false;
      try {
        fromSite = new URL(document.referrer).origin === location.origin;
      } catch {}
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!seen && !fromSite && !location.hash && !still) document.documentElement.classList.add('landing');
    })();
  </script>
  <Landing />
  <Hero />
  <Strips />
  <About />
  <Experience />
  <Work />
  <Incidents />
  <Playground />
  <Contact />
</Base>
